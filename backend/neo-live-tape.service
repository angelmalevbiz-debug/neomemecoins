[Unit]
Description=NEO Meme Coins Solana Live Tape
After=network-online.target neo-fomo-monitor.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/neomemecoins
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /root/neomemecoins/backend/live_tape.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
