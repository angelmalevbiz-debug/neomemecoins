[Unit]
Description=NEO Meme Coins Per-User Paper Gateway
After=network-online.target neo-fomo-monitor.service
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/neo/neo-user-gateway.env
WorkingDirectory=/root/neomemecoins
Environment=PYTHONUNBUFFERED=1
Environment=NEO_USER_GATEWAY_HOST=127.0.0.1
Environment=NEO_USER_GATEWAY_PORT=8789
Environment=NEO_MARKET_UPSTREAM=http://127.0.0.1:8788
Environment=NEO_MARKET_ROOT=/root/neomemecoins
Environment=NEO_USER_STATE_PATH=/var/lib/neo-market/user_accounts.json
Environment=SUPABASE_URL=https://qziuovwcauaklgqscqys.supabase.co
Environment=SUPABASE_PUBLISHABLE_KEY=sb_publishable_IVNFzAWi1kb7NjwTBitA_g_gBVnvrie
ExecStart=/usr/bin/python3 /root/neomemecoins/backend/user_gateway.py
Restart=always
RestartSec=1
TimeoutStopSec=10
KillMode=mixed

[Install]
WantedBy=multi-user.target